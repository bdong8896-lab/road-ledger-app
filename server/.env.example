# 사이트별 배포 시 이 파일을 .env로 복사한 뒤 값만 채우면 됩니다.

PORT=8080

# PostgreSQL 접속 정보 (관공서 서버마다 다름)
PGHOST=localhost
PGPORT=5432
PGDATABASE=road_ledger
PGUSER=road_ledger_app
PGPASSWORD=changeme

# 세션 쿠키 서명 키 (배포마다 무작위 문자열로 교체)
SESSION_SECRET=changeme-session-secret

# VWorld API — 이 서버(프록시)가 VWorld에 보낼 때 사용할 키와 Referer.
# VWorld 개발자센터에 키를 등록할 때 지정한 도메인/IP와 REFERER 값이 일치해야
# 요청이 차단되지 않습니다. 관공서마다 별도 키를 발급받아 등록하세요.
VWORLD_API_KEY=
VWORLD_REFERER=http://localhost/

# 카카오 로드뷰(Roadview)는 public/kakao_sdk.js(DS-LandInfo와 동일한 벤더 SDK)를
# 그대로 사용한다 — 별도 앱키/도메인 등록이 필요 없다.

# 국가교통정보센터(ITS, openapi.its.go.kr) CCTV API 키.
# 고속도로/국도 CCTV만 제공하며, 군도·시도 등 지자체 관리 도로는 포함되지 않는다.
ITS_CCTV_API_KEY=

# 업로드 파일 저장 경로 (절대경로 권장, 없으면 서버가 자동 생성)
UPLOAD_DIR=./uploads

# 정적 파일(프론트엔드)을 어느 폴더에서 서빙할지. 평소엔 비워두면 public/(원본)을
# 그대로 서빙한다. 배포용 난독화 버전을 쓰려면(server에서 `npm run build:dist`로
# public-dist/를 먼저 생성한 뒤) SERVE_DIR=public-dist 로 설정. 원복은 이 값을
# 지우거나 다시 public으로 바꾸고 서버만 재시작하면 된다(파일을 되돌릴 필요 없음).
SERVE_DIR=public

# DWG 파일을 CAD 뷰어에서 볼 수 있게 DXF로 변환할 때 쓰는 변환기 경로.
# 기본값은 server/vendor/libredwg-win64/dwg2dxf.exe(함께 배포되는 LibreDWG, 무료
# 오픈소스)라 보통은 비워둬도 됩니다. 다른 변환기(예: 유료 ODA File Converter)로
# 바꾸고 싶을 때만 여기에 그 실행파일의 전체 경로를 적으세요.
DWG_CONVERTER_PATH=
