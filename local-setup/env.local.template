# 로컬 PC용 환경설정 템플릿 — install-local.ps1 이 @@...@@ 자리를 채워 server\.env 를 만듭니다.
# (직접 만들 때는 이 파일을 server\.env 로 복사하고 @@...@@ 를 모두 실제 값으로 바꾸세요.)

PORT=@@APP_PORT@@

# PostgreSQL (Docker 컨테이너 road-ledger-pg)
PGHOST=localhost
PGPORT=@@PG_PORT@@
PGDATABASE=@@PG_DATABASE@@
PGUSER=@@PG_USER@@
PGPASSWORD=@@PG_PASSWORD@@

# 세션 쿠키 서명 키 (설치마다 무작위로 생성됨)
SESSION_SECRET=@@SESSION_SECRET@@

# 로그인 유지 시간(시간). 개발·검수 PC에서 매번 로그인하기 귀찮으면 720(30일)로 늘려도 된다.
SESSION_MAX_AGE_HOURS=8

# VWorld 지도 키 — 반드시 "이 PC용으로 새로 발급"받은 키를 넣을 것.
# 키는 서비스 URL(Referer)에 잠겨 있어서 다른 PC·서버용 키를 가져오면 지도가 안 뜬다(401/403).
# VWorld 개발자센터(https://www.vworld.kr)에서 서비스 URL 을 http://localhost 로 등록해 발급.
# VWORLD_REFERER 는 키를 발급받을 때 등록한 서비스 URL 과 똑같아야 한다.
VWORLD_API_KEY=@@VWORLD_KEY@@
VWORLD_REFERER=http://localhost/

# 국가교통정보센터(ITS) CCTV 키 — 비워 두면 CCTV 레이어만 비어 있고 오류는 없다.
ITS_CCTV_API_KEY=

# 업로드 파일 저장 경로
UPLOAD_DIR=./uploads

# 로컬에서는 원본(public)을 그대로 서빙한다. (난독화 빌드 public-dist 는 서버 배포용)
SERVE_DIR=public

# DWG→DXF 변환기. 비워 두면 server\vendor\libredwg-win64\dwg2dxf.exe 를 쓴다.
DWG_CONVERTER_PATH=

SITE_COPYRIGHT=

# 관리 콘솔 재인증 유효시간(분)
ADMIN_REAUTH_MINUTES=15
